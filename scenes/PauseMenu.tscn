[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 100
visible = false
script = ExtResource("1_pause")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.04, 0.03, 0.78)

[node name="CenterContainer" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MainPauseVBox" type="VBoxContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="PauseTitle" type="Label" parent="CenterContainer/MainPauseVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.88, 0.76, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.8)
theme_override_constants/shadow_offset_y = 3
theme_override_font_sizes/font_size = 36
text = "P A U S A"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="CenterContainer/MainPauseVBox"]
layout_mode = 2

[node name="ResumeBtn" type="Button" parent="CenterContainer/MainPauseVBox"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_override_colors/font_hover_color = Color(0.98, 0.92, 0.78, 1)
theme_override_colors/font_color = Color(0.92, 0.84, 0.68, 1)
theme_override_font_sizes/font_size = 18
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_primary")
text = "▶  Continuar"

[node name="SettingsBtn" type="Button" parent="CenterContainer/MainPauseVBox"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_colors/font_hover_color = Color(0.95, 0.90, 0.78, 1)
theme_override_colors/font_color = Color(0.85, 0.80, 0.70, 1)
theme_override_font_sizes/font_size = 16
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_normal")
text = "⚙️  Configurações"

[node name="MainMenuBtn" type="Button" parent="CenterContainer/MainPauseVBox"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_colors/font_hover_color = Color(0.95, 0.90, 0.78, 1)
theme_override_colors/font_color = Color(0.85, 0.80, 0.70, 1)
theme_override_font_sizes/font_size = 16
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_normal")
