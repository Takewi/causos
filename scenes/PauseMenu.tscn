layout_mode = 2
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_normal")
text = "Voltar"

[connection signal="pressed" from="CenterContainer/MainPauseVBox/ResumeBtn" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="CenterContainer/MainPauseVBox/SettingsBtn" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="CenterContainer/MainPauseVBox/MainMenuBtn" to="." method="_on_main_menu_pressed"]
[connection signal="pressed" from="CenterContainer/MainPauseVBox/QuitBtn" to="." method="_on_quit_pressed"]
[connection signal="item_selected" from="CenterContainer/SettingsPanel/VBox/FPSHBox/FPSOption" to="." method="_on_fps_selected"]
[connection signal="toggled" from="CenterContainer/SettingsPanel/VBox/VSyncCheck" to="." method="_on_vsync_toggled"]
[connection signal="toggled" from="CenterContainer/SettingsPanel/VBox/FPSCounterCheck" to="." method="_on_fps_counter_toggled"]
[connection signal="pressed" from="CenterContainer/SettingsPanel/VBox/SettingsBackBtn" to="." method="_on_settings_back_pressed"]
