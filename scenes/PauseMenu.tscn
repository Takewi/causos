[node name="QuitBtn" type="Button" parent="CenterContainer/MainPauseVBox"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_colors/font_hover_color = Color(0.95, 0.55, 0.55, 1)
theme_override_colors/font_color = Color(0.75, 0.68, 0.65, 1)
theme_override_font_sizes/font_size = 16
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_normal")
text = "Sair do Jogo"

[node name="SettingsPanel" type="PanelContainer" parent="CenterContainer"]
visible = false
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="CenterContainer/SettingsPanel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="SettingsTitle" type="Label" parent="CenterContainer/SettingsPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.84, 0.65, 1)
theme_override_font_sizes/font_size = 20
text = "Configurações de Desempenho"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="CenterContainer/SettingsPanel/VBox"]
layout_mode = 2

[node name="FPSLabel" type="Label" parent="CenterContainer/SettingsPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.80, 0.75, 0.65, 1)
theme_override_font_sizes/font_size = 14
text = "Limite de Taxa de Quadros (FPS):"

[node name="FPSHBox" type="HBoxContainer" parent="CenterContainer/SettingsPanel/VBox"]
layout_mode = 2

[node name="FPSOption" type="OptionButton" parent="CenterContainer/SettingsPanel/VBox/FPSHBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="VSyncCheck" type="CheckBox" parent="CenterContainer/SettingsPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.80, 0.70, 1)
