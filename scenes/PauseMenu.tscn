[node name="FPSCounterCheck" type="CheckBox" parent="CenterContainer/SettingsPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.80, 0.70, 1)
text = "Exibir Contador de FPS na Tela"

[node name="SettingsBackBtn" type="Button" parent="CenterContainer/SettingsPanel/VBox"]
